"""Readable workflow for the central GraphSAGE PPI reconstruction.

This workflow reconstructs the complete biological row order, PPI topology,
50 input features, 121 GO labels, the four deterministic files consumed by
supervised GraphSAGE, and the downstream DGL representation. Pixi acquires or
verifies immutable files under ``data/`` before Snakemake starts. Snakemake
treats those files only as inputs; generated outputs are confined to ``build/``
and ``results/``. Released GraphSAGE and DGL targets enter only through
``validate``.
"""

from pathlib import Path


configfile: "spec/specification.yaml"

REPRO_ROOT = Path(workflow.basedir).resolve()
PROJECT_ROOT = REPRO_ROOT.parent
SPEC_DIR = REPRO_ROOT / "spec"
DATA_DIR = REPRO_ROOT / "data"
BUILD_DIR = REPRO_ROOT / "build"
RESULTS_DIR = REPRO_ROOT / "results"

SOURCES = SPEC_DIR / "sources.tsv"
GRAPH_SPEC = SPEC_DIR / "selected_graphs.tsv"
FEATURE_SPEC = SPEC_DIR / "feature_columns.tsv"
LABEL_COLUMNS = SPEC_DIR / "label_columns.tsv"
IDENTIFIER_DECISIONS = SPEC_DIR / "identifier_decisions.tsv"
SPECIFICATION = SPEC_DIR / "specification.yaml"

OHMNET = DATA_DIR / "bio-tissue-networks.tar.gz"
OHMNET_README = DATA_DIR / "bio-tissue-readme.txt"
MSIGDB_C1 = DATA_DIR / "c1.all.v6.1.entrez.gmt"
MSIGDB_C3 = DATA_DIR / "c3.all.v6.1.entrez.gmt"
GOA_GAF = DATA_DIR / "goa_human.gaf.159.gz"
GOA_GPI = DATA_DIR / "goa_human.gpi.159.gz"
GP2PROTEIN = DATA_DIR / "2016-06-01-gp2protein.geneid.gz"
GO_ONTOLOGY = DATA_DIR / "2016-06-01-go.obo"
GRAPHSAGE_REFERENCE = DATA_DIR / "graphsage_ppi.zip"
DGL_REFERENCE = DATA_DIR / "dgl_ppi.zip"

SOURCE_REPORT = BUILD_DIR / "sources" / "upstream_sources.json"
REFERENCE_REPORT = BUILD_DIR / "sources" / "graphsage_reference.json"
DGL_REFERENCE_REPORT = BUILD_DIR / "sources" / "dgl_reference.json"
NODE_MAPPING = BUILD_DIR / "topology" / "node_to_entrez.tsv.gz"
EDGE_TABLE = BUILD_DIR / "topology" / "edges.tsv.gz"
TOPOLOGY_SUMMARY = BUILD_DIR / "topology" / "summary.json"
FEATURE_MATRIX = BUILD_DIR / "features" / "ppi-feats.npy"
SELECTED_FEATURES = BUILD_DIR / "features" / "selected_features.tsv"
FEATURE_SUMMARY = BUILD_DIR / "features" / "summary.json"
LABEL_MATRIX = BUILD_DIR / "labels" / "ppi-labels.npy"
CLASS_MAP = BUILD_DIR / "labels" / "ppi-class_map.json"
SELECTED_LABELS = BUILD_DIR / "labels" / "selected_labels.tsv"
LABEL_SUMMARY = BUILD_DIR / "labels" / "summary.json"
GRAPHSAGE_SUMMARY = BUILD_DIR / "graphsage" / "summary.json"
GRAPHSAGE_ROOT = RESULTS_DIR / "graphsage"
GRAPHSAGE_DIR = GRAPHSAGE_ROOT / "ppi"
GRAPHSAGE_GRAPH = GRAPHSAGE_DIR / "ppi-G.json"
GRAPHSAGE_ID_MAP = GRAPHSAGE_DIR / "ppi-id_map.json"
GRAPHSAGE_CLASS_MAP = GRAPHSAGE_DIR / "ppi-class_map.json"
GRAPHSAGE_FEATURES = GRAPHSAGE_DIR / "ppi-feats.npy"
GRAPHSAGE_CHECKSUMS = GRAPHSAGE_ROOT / "SHA256SUMS"
DGL_SUMMARY = BUILD_DIR / "dgl" / "summary.json"
DGL_ROOT = RESULTS_DIR / "dgl"
DGL_DIR = DGL_ROOT / "ppi"
DGL_DATA_FILES = [
    str(DGL_DIR / f"{split}_{suffix}")
    for split in ("train", "valid", "test")
    for suffix in ("graph.json", "feats.npy", "labels.npy", "graph_id.npy")
]
DGL_CHECKSUMS = DGL_ROOT / "SHA256SUMS"
RECONSTRUCTION_CHECKS = BUILD_DIR / "reconstruction_checks.json"
RUN_MANIFEST = RESULTS_DIR / "reconstruction_manifest.json"
GRAPHSAGE_VALIDATION_JSON = RESULTS_DIR / "graphsage_validation.json"
GRAPHSAGE_VALIDATION_MD = RESULTS_DIR / "graphsage_validation.md"
DGL_VALIDATION_JSON = RESULTS_DIR / "dgl_validation.json"
DGL_VALIDATION_MD = RESULTS_DIR / "dgl_validation.md"

LABEL_CONFIG = config["reconstruction"]["labels"]
GRAPHSAGE_CONFIG = config["reconstruction"]["graphsage"]
EVIDENCE_FLAGS = " ".join(
    f"--evidence-code {code}" for code in LABEL_CONFIG["evidence_codes"]
)
RELATION_FLAGS = " ".join(
    f"--allowed-relation {relation}"
    for relation in LABEL_CONFIG["allowed_relations"].values()
)


rule all:
    input:
        str(RUN_MANIFEST),


rule reproduce:
    input:
        str(RUN_MANIFEST),


rule validate:
    input:
        str(GRAPHSAGE_VALIDATION_JSON),
        str(GRAPHSAGE_VALIDATION_MD),
        str(DGL_VALIDATION_JSON),
        str(DGL_VALIDATION_MD),


rule verify_upstream_sources:
    input:
        manifest=str(SOURCES),
        ohmnet=str(OHMNET),
        ohmnet_readme=str(OHMNET_README),
        c1=str(MSIGDB_C1),
        c3=str(MSIGDB_C3),
        gaf=str(GOA_GAF),
        gpi=str(GOA_GPI),
        gp2protein=str(GP2PROTEIN),
        ontology=str(GO_ONTOLOGY),
    output:
        report=str(SOURCE_REPORT),
    params:
        data_dir=str(DATA_DIR),
    shell:
        """
        python -m graphsage_ppi_repro.cli ensure-sources \
          --manifest {input.manifest:q} \
          --data-dir {params.data_dir:q} \
          --source-id ohmnet_networks \
          --source-id ohmnet_readme \
          --source-id msigdb_c1_v61 \
          --source-id msigdb_c3_v61 \
          --source-id goa_human_gaf_159 \
          --source-id goa_human_gpi_159 \
          --source-id gp2protein_geneid_20160601 \
          --source-id go_ontology_20160601 \
          --report {output.report:q}
        """


rule reconstruct_topology:
    input:
        archive=str(OHMNET),
        source_report=rules.verify_upstream_sources.output.report,
        graph_spec=str(GRAPH_SPEC),
    output:
        mapping=str(NODE_MAPPING),
        edges=str(EDGE_TABLE),
        summary=str(TOPOLOGY_SUMMARY),
    params:
        word_size_bits=config["reconstruction"]["node_order"]["word_size_bits"],
    shell:
        """
        python -m graphsage_ppi_repro.cli reconstruct-topology \
          --archive {input.archive:q} \
          --graph-spec {input.graph_spec:q} \
          --mapping-output {output.mapping:q} \
          --edge-output {output.edges:q} \
          --summary-output {output.summary:q} \
          --word-size-bits {params.word_size_bits}
        """


rule reconstruct_features:
    input:
        mapping=rules.reconstruct_topology.output.mapping,
        c1=str(MSIGDB_C1),
        c3=str(MSIGDB_C3),
        source_report=rules.verify_upstream_sources.output.report,
        feature_spec=str(FEATURE_SPEC),
    output:
        matrix=str(FEATURE_MATRIX),
        selected=str(SELECTED_FEATURES),
        summary=str(FEATURE_SUMMARY),
    params:
        minimum=config["reconstruction"]["features"]["minimum_source_members"],
        maximum=config["reconstruction"]["features"]["maximum_columns"],
    shell:
        """
        python -m graphsage_ppi_repro.cli reconstruct-features \
          --mapping {input.mapping:q} \
          --c1 {input.c1:q} \
          --c3 {input.c3:q} \
          --feature-spec {input.feature_spec:q} \
          --matrix-output {output.matrix:q} \
          --selected-output {output.selected:q} \
          --summary-output {output.summary:q} \
          --minimum-source-members {params.minimum} \
          --maximum-columns {params.maximum}
        """


rule reconstruct_labels:
    input:
        mapping=rules.reconstruct_topology.output.mapping,
        gaf=str(GOA_GAF),
        gpi=str(GOA_GPI),
        gp2protein=str(GP2PROTEIN),
        ontology=str(GO_ONTOLOGY),
        label_columns=str(LABEL_COLUMNS),
        identifier_decisions=str(IDENTIFIER_DECISIONS),
        source_report=rules.verify_upstream_sources.output.report,
    output:
        matrix=str(LABEL_MATRIX),
        class_map=str(CLASS_MAP),
        selected=str(SELECTED_LABELS),
        summary=str(LABEL_SUMMARY),
    params:
        evidence_flags=EVIDENCE_FLAGS,
        relation_flags=RELATION_FLAGS,
        selected_term_count=LABEL_CONFIG["selected_term_count"],
    shell:
        """
        python -m graphsage_ppi_repro.cli reconstruct-labels \
          --mapping {input.mapping:q} \
          --gaf {input.gaf:q} \
          --gpi {input.gpi:q} \
          --gp2protein {input.gp2protein:q} \
          --ontology {input.ontology:q} \
          --label-columns {input.label_columns:q} \
          --identifier-decisions {input.identifier_decisions:q} \
          --matrix-output {output.matrix:q} \
          --class-map-output {output.class_map:q} \
          --selected-labels-output {output.selected:q} \
          --summary-output {output.summary:q} \
          {params.evidence_flags} \
          {params.relation_flags} \
          --selected-term-count {params.selected_term_count}
        """


rule assemble_graphsage:
    input:
        mapping=rules.reconstruct_topology.output.mapping,
        edges=rules.reconstruct_topology.output.edges,
        features=rules.reconstruct_features.output.matrix,
        labels=rules.reconstruct_labels.output.matrix,
    output:
        graph=str(GRAPHSAGE_GRAPH),
        id_map=str(GRAPHSAGE_ID_MAP),
        class_map=str(GRAPHSAGE_CLASS_MAP),
        features=str(GRAPHSAGE_FEATURES),
        checksums=str(GRAPHSAGE_CHECKSUMS),
        summary=str(GRAPHSAGE_SUMMARY),
    params:
        output_directory=str(GRAPHSAGE_DIR),
        word_size_bits=GRAPHSAGE_CONFIG["class_map_word_size_bits"],
    shell:
        """
        python -m graphsage_ppi_repro.cli assemble-graphsage \
          --mapping {input.mapping:q} \
          --edges {input.edges:q} \
          --features {input.features:q} \
          --labels {input.labels:q} \
          --output-directory {params.output_directory:q} \
          --summary-output {output.summary:q} \
          --word-size-bits {params.word_size_bits}
        """


rule assemble_dgl:
    input:
        graph=rules.assemble_graphsage.output.graph,
        id_map=rules.assemble_graphsage.output.id_map,
        class_map=rules.assemble_graphsage.output.class_map,
        features=rules.assemble_graphsage.output.features,
        graph_spec=str(GRAPH_SPEC),
    output:
        data=DGL_DATA_FILES,
        checksums=str(DGL_CHECKSUMS),
        summary=str(DGL_SUMMARY),
    params:
        output_directory=str(DGL_DIR),
    shell:
        """
        python -m graphsage_ppi_repro.cli assemble-dgl \
          --graph {input.graph:q} \
          --id-map {input.id_map:q} \
          --class-map {input.class_map:q} \
          --features {input.features:q} \
          --graph-spec {input.graph_spec:q} \
          --output-directory {params.output_directory:q} \
          --summary-output {output.summary:q}
        """


rule check_reconstruction:
    input:
        specification=str(SPECIFICATION),
        topology=rules.reconstruct_topology.output.summary,
        features=rules.reconstruct_features.output.summary,
        labels=rules.reconstruct_labels.output.summary,
        graphsage=rules.assemble_graphsage.output.summary,
    output:
        checks=str(RECONSTRUCTION_CHECKS),
    shell:
        """
        python -m graphsage_ppi_repro.cli check-reconstruction \
          --specification {input.specification:q} \
          --topology-summary {input.topology:q} \
          --feature-summary {input.features:q} \
          --label-summary {input.labels:q} \
          --graphsage-summary {input.graphsage:q} \
          --output {output.checks:q}
        """


rule write_reconstruction_manifest:
    input:
        source_report=rules.verify_upstream_sources.output.report,
        mapping=rules.reconstruct_topology.output.mapping,
        edges=rules.reconstruct_topology.output.edges,
        topology_summary=rules.reconstruct_topology.output.summary,
        feature_matrix=rules.reconstruct_features.output.matrix,
        selected_features=rules.reconstruct_features.output.selected,
        feature_summary=rules.reconstruct_features.output.summary,
        label_matrix=rules.reconstruct_labels.output.matrix,
        class_map=rules.reconstruct_labels.output.class_map,
        selected_labels=rules.reconstruct_labels.output.selected,
        label_summary=rules.reconstruct_labels.output.summary,
        graphsage_graph=rules.assemble_graphsage.output.graph,
        graphsage_id_map=rules.assemble_graphsage.output.id_map,
        graphsage_class_map=rules.assemble_graphsage.output.class_map,
        graphsage_features=rules.assemble_graphsage.output.features,
        graphsage_checksums=rules.assemble_graphsage.output.checksums,
        graphsage_summary=rules.assemble_graphsage.output.summary,
        dgl_files=rules.assemble_dgl.output.data,
        dgl_checksums=rules.assemble_dgl.output.checksums,
        dgl_summary=rules.assemble_dgl.output.summary,
        checks=rules.check_reconstruction.output.checks,
        sources=str(SOURCES),
        specification=str(SPECIFICATION),
        graph_spec=str(GRAPH_SPEC),
        feature_spec=str(FEATURE_SPEC),
        label_columns=str(LABEL_COLUMNS),
        identifier_decisions=str(IDENTIFIER_DECISIONS),
    output:
        manifest=str(RUN_MANIFEST),
    params:
        project_root=str(PROJECT_ROOT),
        reproduction_root=str(REPRO_ROOT),
    shell:
        """
        python -m graphsage_ppi_repro.cli write-manifest \
          --output {output.manifest:q} \
          --project-root {params.project_root:q} \
          --reproduction-root {params.reproduction_root:q} \
          --source-report {input.source_report:q} \
          --stage complete_graphsage_and_dgl \
          --artifact {input.mapping:q} \
          --artifact {input.edges:q} \
          --artifact {input.topology_summary:q} \
          --artifact {input.feature_matrix:q} \
          --artifact {input.selected_features:q} \
          --artifact {input.feature_summary:q} \
          --artifact {input.label_matrix:q} \
          --artifact {input.class_map:q} \
          --artifact {input.selected_labels:q} \
          --artifact {input.label_summary:q} \
          --artifact {input.graphsage_graph:q} \
          --artifact {input.graphsage_id_map:q} \
          --artifact {input.graphsage_class_map:q} \
          --artifact {input.graphsage_features:q} \
          --artifact {input.graphsage_checksums:q} \
          --artifact {input.graphsage_summary:q} \
          --artifact {input.dgl_checksums:q} \
          --artifact {input.dgl_summary:q} \
          --artifact {input.checks:q} \
          --specification {input.sources:q} \
          --specification {input.specification:q} \
          --specification {input.graph_spec:q} \
          --specification {input.feature_spec:q} \
          --specification {input.label_columns:q} \
          --specification {input.identifier_decisions:q}
        """


rule verify_graphsage_reference:
    input:
        manifest=str(SOURCES),
        archive=str(GRAPHSAGE_REFERENCE),
    output:
        report=str(REFERENCE_REPORT),
    params:
        data_dir=str(DATA_DIR),
    shell:
        """
        python -m graphsage_ppi_repro.cli ensure-sources \
          --manifest {input.manifest:q} \
          --data-dir {params.data_dir:q} \
          --source-id graphsage_ppi_reference \
          --role reference \
          --report {output.report:q}
        """


rule validate_graphsage:
    input:
        reconstruction=rules.write_reconstruction_manifest.output.manifest,
        reference=str(GRAPHSAGE_REFERENCE),
        reference_report=rules.verify_graphsage_reference.output.report,
        graph=rules.assemble_graphsage.output.graph,
        id_map=rules.assemble_graphsage.output.id_map,
        class_map=rules.assemble_graphsage.output.class_map,
        features=rules.assemble_graphsage.output.features,
    output:
        json=str(GRAPHSAGE_VALIDATION_JSON),
        markdown=str(GRAPHSAGE_VALIDATION_MD),
    shell:
        """
        python -m graphsage_ppi_repro.cli validate-graphsage \
          --reference {input.reference:q} \
          --graph {input.graph:q} \
          --id-map {input.id_map:q} \
          --class-map {input.class_map:q} \
          --features {input.features:q} \
          --json-output {output.json:q} \
          --markdown-output {output.markdown:q}
        """


rule verify_dgl_reference:
    input:
        manifest=str(SOURCES),
        archive=str(DGL_REFERENCE),
    output:
        report=str(DGL_REFERENCE_REPORT),
    params:
        data_dir=str(DATA_DIR),
    shell:
        """
        python -m graphsage_ppi_repro.cli ensure-sources \
          --manifest {input.manifest:q} \
          --data-dir {params.data_dir:q} \
          --source-id dgl_ppi_reference \
          --role reference \
          --report {output.report:q}
        """


rule validate_dgl:
    input:
        reconstruction=rules.write_reconstruction_manifest.output.manifest,
        reference=str(DGL_REFERENCE),
        reference_report=rules.verify_dgl_reference.output.report,
        data=rules.assemble_dgl.output.data,
        checksums=rules.assemble_dgl.output.checksums,
        summary=rules.assemble_dgl.output.summary,
    output:
        json=str(DGL_VALIDATION_JSON),
        markdown=str(DGL_VALIDATION_MD),
    params:
        directory=str(DGL_DIR),
        atol=config["validation"]["dgl_feature_atol"],
        rtol=config["validation"]["dgl_feature_rtol"],
    shell:
        """
        python -m graphsage_ppi_repro.cli validate-dgl \
          --reference {input.reference:q} \
          --directory {params.directory:q} \
          --json-output {output.json:q} \
          --markdown-output {output.markdown:q} \
          --feature-atol {params.atol} \
          --feature-rtol {params.rtol}
        """
